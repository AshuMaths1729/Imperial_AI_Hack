# Optional: the agent also reads the repo-root .env (values here win).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SYNTHESIA_API_KEY=
ANTHROPIC_API_KEY=
ELEVEN_API_KEY=
# must match the backend's TUTOR_AGENT_NAME; use a per-developer name, e.g. tutor-fuchun
TUTOR_AGENT_NAME=scholartwin-tutor
# 0 = voice only (no Synthesia session)
TUTOR_AVATAR=1

  "equation_latex": "\\ddot{\\theta}(t) + \\gamma \\dot{\\theta}(t) + \\eta \\nabla L(\\theta(t)) = 0",
  "paper_title": "Heavy-Ball Momentum Dynamics",
  "arxiv_id": null,
  "python_code": "import math\n\nPARAMS = {\n    \"gamma\": {\"min\": 0.05, \"max\": 1.5, \"default\": 0.35, \"step\": 0.05, \"unit\": \"1/s\",\n              \"label\": \"Damping γ\"},\n    \"eta\": {\"min\": 0.5, \"max\": 5.0, \"default\": 2.4, \"step\": 0.1, \"unit\": \"\",\n            \"label\": \"Stiffness η\"},\n    \"theta0\": {\"min\": 0.5, \"max\": 3.0, \"default\": 1.8, \"step\": 0.1, \"unit\": \"rad\",\n               \"label\": \"Initial displacement θ₀\"},\n}\n\n\ndef simulate(gamma=0.35, eta=2.4, theta0=1.8):\n    steps, dt = 180, 0.08\n    t = [round(i * dt, 2) for i in range(steps)]\n    theta = [0.0] * steps\n    vel = [0.0] * steps\n    energy = [0.0] * steps\n    envelope = [0.0] * steps\n    theta[0] = theta0\n    energy[0] = round(0.5 * theta0 ** 2, 4)\n    envelope[0] = round(theta0, 4)\n    for i in range(1, steps):\n        grad = theta[i - 1] + 0.15 * math.sin(3.0 * theta[i - 1])\n        vel[i] = vel[i - 1] + dt * (-gamma * vel[i - 1] - eta * grad)\n        theta[i] = round(theta[i - 1] + dt * vel[i], 4)\n        energy[i] = round(0.5 * theta[i] ** 2 + 0.5 * vel[i] ** 2 / max(eta, 0.1), 4)\n        envelope[i] = round(theta0 * math.exp(-0.5 * gamma * i * dt), 4)\n    return {\n        \"title\": \"Heavy-ball momentum ODE\",\n        \"x_label\": \"t (s)\",\n        \"y_label\": \"Amplitude / energy\",\n        \"series\": [\n            {\"name\": \"Parameter trajectory θ(t)\", \"x\": t, \"y\": theta, \"color\": \"#38bdf8\"},\n            {\"name\": \"Loss energy E(t)\", \"x\": t, \"y\": energy, \"color\": \"#f43f5e\"},\n            {\"name\": \"Damping envelope\", \"x\": t, \"y\": envelope, \"color\": \"#a855f7\"},\n        ],\n    }\n"
}

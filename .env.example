# Copy to `.env` (repo root or backend/) and fill in. `.env` is gitignored; never commit keys.
# Only variable NAMES live here; secrets stay server-side and are never sent to the browser.

# --- API keys / credentials (server-side only) ---
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ANAM_API_KEY=
FAL_KEY=
SYNTHESIA_API_KEY=
S2_API_KEY=
# contact email for the OpenAlex polite pool
OPENALEX_MAILTO=

# --- cache / offline ---
# live = call out and cache; offline = serve only from cache and fail loudly on a miss;
# refresh = call out and overwrite the cache. OFFLINE=1 is an alias for CACHE_MODE=offline.
CACHE_MODE=live
# OFFLINE=1

# --- backends / feature flags ---
EXTRACTOR_BACKEND=frontier
ASK_BACKEND=canned
FAL_MCP_ENABLED=false
RESEARCH_AGENT=false

# --- per-route models and effort (output_config.effort: low | medium | high) ---
MODEL_EXTRACT=claude-opus-5-5
MODEL_CODEGEN=claude-opus-5-5
MODEL_ASK=claude-opus-5-5
MODEL_QUIZ=claude-opus-5-5
EFFORT_EXTRACT=medium
EFFORT_COMPARE=high
EFFORT_CODEGEN=high
EFFORT_ASK=low
EFFORT_QUIZ=low
EFFORT_RESEARCH=medium

# --- HTTP ---
# comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

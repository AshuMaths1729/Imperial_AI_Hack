    "Axes": {
      "additionalProperties": false,
      "description": "A coordinate frame: x,y,w,h is its box on the canvas; ranges are in maths units.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,40}$",
          "title": "Id",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "enum": [
                "blue",
                "teal",
                "green",
                "yellow",
                "gold",
                "red",
                "purple",
                "pink",
                "white",
                "grey"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "kind": {
          "const": "axes",
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "w": {
          "exclusiveMinimum": 0,
          "title": "W",
          "type": "number"
        },
        "h": {
          "exclusiveMinimum": 0,
          "title": "H",
          "type": "number"
        },
        "x_range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "X Range",
          "type": "array"
        },
        "y_range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Y Range",
          "type": "array"
        },
        "x_label": {
          "default": "",
          "maxLength": 120,
          "title": "X Label",
          "type": "string"
        },
        "y_label": {
          "default": "",
          "maxLength": 120,
          "title": "Y Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "w",
        "h",
        "x_range",
        "y_range"
      ],
      "title": "Axes",
      "type": "object"
    },

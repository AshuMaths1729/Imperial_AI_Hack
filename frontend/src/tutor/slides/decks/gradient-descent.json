     "y": 390,
     "size": 34
    },
    {
     "kind": "math",
     "id": "pos",
     "latex": "\\textcolor{#FFE45C}{\\frac{dL}{d\\theta}} > 0 \\;\\Rightarrow\\; \\text{downhill is left}",

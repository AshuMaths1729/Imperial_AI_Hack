     "y": 530,
     "size": 36
    },
    {
     "kind": "math",
     "id": "rule2",
     "latex": "\\textcolor{#83C167}{-\\nabla L} \\text{ points downhill}",
     "x": 1300,
     "y": 600,
     "size": 36
    }
   ],
   "steps": [
    {
     "narration": "Stand at this point and feel the ground under your feet.",
     "actions": [
      {
       "do": "show",
       "ids": [
